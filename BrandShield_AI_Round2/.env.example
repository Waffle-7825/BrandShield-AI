# Enable authenticated mode. Never commit real secrets.
BRANDSHIELD_AUTH_SECRET=replace-with-at-least-32-random-characters
BRANDSHIELD_ADMIN_EMAIL=admin@example.com
BRANDSHIELD_ADMIN_PASSWORD=replace-with-a-unique-password-of-12-or-more-characters
# For Render persistent disk mounted at /var/data:
BRANDSHIELD_DATA_DIR=/var/data
